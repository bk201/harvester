#!/bin/bash
set -ex

INSTALLER_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." &> /dev/null && pwd )"
HARVESTER_DIR="$( cd "${INSTALLER_DIR}/.." &> /dev/null && pwd )"
INSTALLER_SCRIPT_DIR="${INSTALLER_DIR}/scripts"
PACKAGE_HARVESTER_OS_DIR="${INSTALLER_DIR}/package/harvester-os"

# --- start loading addon versions ---
source ${INSTALLER_SCRIPT_DIR}/lib/addon
addons_path=${HARVESTER_DIR}/../addons
load_and_source_addon ${addons_path} https://github.com/harvester/addons.git main

MONITORING_VERSION=${RANCHER_MONITORING_CHART_VERSION}
LOGGING_VERSION=${RANCHER_LOGGING_CHART_VERSION}
echo "HARVESTER_EVENTROUTER_FULL_TAG: $HARVESTER_EVENTROUTER_FULL_TAG"
# --- finish loading addon versions ---

source ${INSTALLER_SCRIPT_DIR}/version-rke2
source ${INSTALLER_SCRIPT_DIR}/version-rancher

# Source version variables (from repo root)
. ${HARVESTER_DIR}/harvester-env.sh

version=${HARVESTER_VERSION}
commit=${HARVESTER_COMMIT}
chart_version=${HARVESTER_CHART_VERSION}

echo "=============================="
echo "Installer version: ${version}"
echo "Harvester version: ${version}"
echo "Harvester chart version: ${chart_version}"
echo "Rancher version: ${RANCHER_VERSION}"
echo "Rancher monitoring version: ${MONITORING_VERSION}"
echo "Rancher logging version: ${LOGGING_VERSION}"
echo "Kubeovn operator version: ${KUBEOVN_OPERATOR_CHART_VERSION}"
echo "The ARCH is: ${ARCH}"

# Build the installer binary
cd ${HARVESTER_DIR}
mkdir -p bin

LINKFLAGS="-X github.com/harvester/harvester-installer/pkg/config.RKE2Version=$RKE2_VERSION
           -X github.com/harvester/harvester-installer/pkg/config.RancherVersion=$RANCHER_VERSION
           -X github.com/harvester/harvester-installer/pkg/version.Version=$version
           -X github.com/harvester/harvester-installer/pkg/version.GitCommit=$commit
           -X github.com/harvester/harvester-installer/pkg/version.HarvesterVersion=$version
           -X github.com/harvester/harvester-installer/pkg/config.HarvesterChartVersion=$chart_version
           -X github.com/harvester/harvester-installer/pkg/config.MonitoringChartVersion=$MONITORING_VERSION
           -X github.com/harvester/harvester-installer/pkg/config.LoggingChartVersion=$LOGGING_VERSION
           -X github.com/harvester/harvester-installer/pkg/config.KubeovnOperatorChartVersion=$KUBEOVN_OPERATOR_CHART_VERSION
           $LINKFLAGS"

if [ "$(uname)" = "Linux" ]; then
    if [ -n "${REMOTE_DEBUG}" ]; then
        OTHER_COMPILERFLAGS="all=-N -l"
        OTHER_LINKFLAGS="-extldflags -static"
    else
        OTHER_LINKFLAGS="-extldflags -static -s"
    fi
fi

# render template files
cd ${addons_path}
go run . -generateTemplates -path ${INSTALLER_DIR}/pkg/config/templates

echo "Building harvester-installer binary..."
cd ${HARVESTER_DIR}

CGO_ENABLED=0 go build -gcflags "${OTHER_COMPILERFLAGS}" -ldflags "$LINKFLAGS $OTHER_LINKFLAGS" -o bin/harvester-installer ./installer

echo "Build complete: bin/harvester-installer"

mkdir -p ${PACKAGE_HARVESTER_OS_DIR}/files/usr/bin
install bin/harvester-installer ${PACKAGE_HARVESTER_OS_DIR}/files/usr/bin/

#!/bin/bash
set -e

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$MK_ENV_FILE"

echo "Building offline bundle for Harvester ${HARVESTER_VERSION}..."

docker build \
    --progress="$MK_DOCKER_PROGRESS" \
    --build-arg MK_BUNDLE_BUILDER_IMAGE \
    --build-arg MK_CONTAINER_WORKDIR \
    --build-arg MK_ENV_FILE_NAME \
    -f "$SCRIPT_DIR/Dockerfile" \
    -t "$MK_BUNDLE_IMAGE" \
    "$MK_ROOT"

echo "Bundle image created: $MK_BUNDLE_IMAGE"
echo "  Bundle path (in image): ${MK_CONTAINER_WORKDIR}/installer/package/harvester-os/iso/bundle/"
echo "  Charts path (in image): ${MK_CONTAINER_WORKDIR}/installer/package/harvester-repo/charts/"

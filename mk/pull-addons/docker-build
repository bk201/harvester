#!/bin/bash
set -e

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
STAMP_FILE="$SCRIPT_DIR/../.addons.stamp"

REMOTE_URL="https://github.com/harvester/addons.git"
BRANCH="main"

echo "Checking remote addons commit..."
REMOTE_SHA=$(git ls-remote "$REMOTE_URL" "refs/heads/$BRANCH" | cut -f1)

# Check if we need to rebuild
IMAGE_EXISTS=$(docker images -q "$MK_ADDONS_IMAGE" 2>/dev/null)

if [ -f "$STAMP_FILE" ] && [ -n "$IMAGE_EXISTS" ]; then
    CACHED_SHA=$(cat "$STAMP_FILE")
    if [ "$REMOTE_SHA" = "$CACHED_SHA" ]; then
        echo "Addons unchanged (${REMOTE_SHA:0:8}), skipping pull"
        exit 0
    fi
    echo "Addons changed: ${CACHED_SHA:0:8} -> ${REMOTE_SHA:0:8}"
elif [ ! -n "$IMAGE_EXISTS" ]; then
    echo "Addons image not found, rebuilding..."
fi

echo "Pulling addons into image $MK_ADDONS_IMAGE..."

docker build \
    --no-cache \
    --progress="$MK_DOCKER_PROGRESS" \
    -f "$SCRIPT_DIR/Dockerfile" \
    -t "$MK_ADDONS_IMAGE" \
    "$SCRIPT_DIR"

echo "$REMOTE_SHA" > "$STAMP_FILE"
echo "Addons image ready: $MK_ADDONS_IMAGE (${REMOTE_SHA:0:8})"

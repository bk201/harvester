#!/bin/bash
set -e

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

IMAGE="harvester-generate-manifest:${MK_REPO_ID}"
OUT_DIR="${MK_ROOT}/deploy/charts/harvester-crd/templates"
CONTAINER_OUT_DIR="${MK_CONTAINER_WORKDIR}/deploy/charts/harvester-crd/templates"

docker build \
    --progress="${MK_DOCKER_PROGRESS}" \
    --build-arg MK_BUILDER_IMAGE \
    --build-arg MK_CONTAINER_WORKDIR \
    -f "${SCRIPT_DIR}/Dockerfile" \
    -t "${IMAGE}" \
    "${MK_ROOT}"

echo "Extracting generated CRDs..."
id=$(docker create "${IMAGE}")
cleanup() { docker rm -f "${id}" >/dev/null 2>&1 || true; }
trap cleanup EXIT

rm -f "${OUT_DIR}"/harvesterhci.io*.yaml
docker cp "${id}:${CONTAINER_OUT_DIR}/." "${OUT_DIR}/"

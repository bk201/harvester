#!/bin/bash
set -e

# Arguments passed from Makefile
ENV_FILE="$1"
ROOT="$2"
DOCKER_PROGRESS="${3:-auto}"

# Source version variables
. "$ENV_FILE"

echo "Packaging harvester-webhook image..."
echo "  Version: $HARVESTER_VERSION"
echo "  Tag: $HARVESTER_REPO/harvester-webhook:$HARVESTER_TAG"
echo "  Push tag: $HARVESTER_REPO/harvester-webhook:$HARVESTER_IMAGE_PUSH_TAG"

# Copy binary to package directory
echo "Copying binary to package directory..."
cp "$ROOT/bin/harvester-webhook" "$ROOT/package/harvester-webhook"

# Build final image from mk/package-harvester-webhook/Dockerfile
echo "Building final image from mk/package-harvester-webhook/Dockerfile..."
docker build \
    --progress="$DOCKER_PROGRESS" \
    -f "$(dirname "$0")/Dockerfile" \
    -t "$HARVESTER_REPO/harvester-webhook:$HARVESTER_TAG" \
    "$ROOT/package/"

# Tag with additional tag
echo "Tagging image..."
docker tag \
    "$HARVESTER_REPO/harvester-webhook:$HARVESTER_TAG" \
    "$HARVESTER_REPO/harvester-webhook:$HARVESTER_IMAGE_PUSH_TAG"

echo "Package complete: $HARVESTER_REPO/harvester-webhook:$HARVESTER_TAG"

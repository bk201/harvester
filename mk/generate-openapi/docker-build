#!/bin/bash
set -e

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

source "$SCRIPT_DIR/../lib.sh"

IMAGE="harvester-generate-openapi:${MK_REPO_ID}"
WORKDIR="${MK_CONTAINER_WORKDIR}"

set_mk_docker_build_args

docker build "${MK_DOCKER_BUILD_ARGS[@]}" \
    -f "${SCRIPT_DIR}/Dockerfile" \
    -t "${IMAGE}" \
    "${MK_ROOT}"

echo "Extracting generated OpenAPI artifacts..."
id=$(docker create "${IMAGE}")
cleanup() { docker rm -f "${id}" >/dev/null 2>&1 || true; }
trap cleanup EXIT

docker cp "${id}:${WORKDIR}/api/openapi-spec/swagger.json" "${ROOT}/api/openapi-spec/swagger.json"
docker cp "${id}:${WORKDIR}/scripts/known-api-rule-violations.txt" \
    "${ROOT}/scripts/known-api-rule-violations.txt"

#!/bin/bash
set -e

# Source version variables
. "$MK_ENV_FILE"

echo "Packaging harvester image..."
echo "  Version: $HARVESTER_VERSION"
echo "  Tag: $HARVESTER_REPO/harvester:$HARVESTER_TAG"
echo "  Push tag: $HARVESTER_REPO/harvester:$HARVESTER_IMAGE_PUSH_TAG"

# Copy binary to package directory
echo "Copying binary to package directory..."
cp "$MK_ROOT/bin/harvester" "$MK_ROOT/package/harvester"

# Build final image from mk/package-harvester/Dockerfile
echo "Building final image from mk/package-harvester/Dockerfile..."
docker build \
    --progress="$MK_DOCKER_PROGRESS" \
    -f "$(dirname "${BASH_SOURCE[0]}")/Dockerfile" \
    -t "$HARVESTER_REPO/harvester:$HARVESTER_TAG" \
    "$MK_ROOT/package/"

# Tag with additional tag
echo "Tagging image..."
docker tag \
    "$HARVESTER_REPO/harvester:$HARVESTER_TAG" \
    "$HARVESTER_REPO/harvester:$HARVESTER_IMAGE_PUSH_TAG"

echo "Package complete: $HARVESTER_REPO/harvester:$HARVESTER_TAG"
